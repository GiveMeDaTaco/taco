-- Waterfall Report – Non-BA Segments (claim & exclude logic)
-- ---------------------------------------------------------------------------
--  Requirements distilled from temp/logic.txt
--  -------------------------------------------------------------
--  • Process the ordered list of *segments* for a channel.
--  • For each segment N
--        – Candidate pool   = population that has NOT been bucketed by a
--                              previous segment (N-1, N-2, …).
--        – Claimed rows     = subset of candidate pool that passes the
--                              segment’s summary condition.
--        – Produce 6 rows of output:
--              0. section="<seg name>", stat_name='Records Claimed'
--              1-5 waterfall metrics (unique_drops, incremental_drops,
--                 cumulative_drops, regain, remaining) evaluated **on the
--                 candidate pool**, not on claimed rows.
--
--  Context provided by WaterfallEngine
--  -------------------------------------------------------------
--    eligibility_table   – smart table (aliased as c in conditions)
--    unique_identifiers  – list[str]  id columns (possibly qualified)
--    pre_filter          – SQL predicate satisfied by *every* row that
--                          reaches this template (main BA + channel BA)
--    segments            – ordered list of dicts
--                            name           – display label
--                            checks         – list[str] flag column names
--                            summary_column – SQL predicate defining the
--                                            bucket for the segment
-- ---------------------------------------------------------------------------

{# Strip aliases from UID list for later convenience #}
{% set uid_cols = [] %}
{% for _uid in unique_identifiers %}
    {% set _ = uid_cols.append(_uid.split('.')[-1]) %}
{% endfor %}

{# ----------------------------------------------------------------------- #}
{# Determine the complete list of flag columns required for downstream logic #}
{# ----------------------------------------------------------------------- #}
{% set all_seg_checks = [] %}
{% for seg in segments %}
    {% for chk in seg.checks %}{% if chk not in all_seg_checks %}{% set _ = all_seg_checks.append(chk) %}{% endif %}{% endfor %}
{% endfor %}

{# ----------------------------------------------------------------------- #}
{# Build two parallel lists:                                           #}
{#   * cols_select – projection list for base_population with AS aliases #}
{#   * cols_unq     – plain, unqualified column names used downstream   #}
{# ----------------------------------------------------------------------- #}

{% set cols_select = [] %}
{% set cols_unq = [] %}

{% set _tmp = unique_identifiers + all_seg_checks %}
{% for col in _tmp %}
    {% if '.' in col %}
        {% set stripped = col.split('.')[-1] %}
        {% if stripped not in cols_unq %}{% set _ = cols_unq.append(stripped) %}{% endif %}
        {% set _ = cols_select.append(col ~ ' AS ' ~ stripped) %}
    {% else %}
        {% if col not in cols_unq %}{% set _ = cols_unq.append(col) %}{% endif %}
        {% set _ = cols_select.append(col) %}
    {% endif %}
{% endfor %}

{# cols_unq now contains the deduplicated, unqualified column names #}

WITH base_population AS (
    -- Narrow projection to just IDs + segment flag columns to minimise spool
    SELECT {{ cols_select | join(',\n           ') }}
    FROM {{ eligibility_table }} AS c
    WHERE {{ pre_filter }}
),

-- ---------------------------------------------------------------------------
-- Deduplication (same tie-break rules as full waterfall)
-- ---------------------------------------------------------------------------

-- all_seg_checks already defined above

{# Prepare helper expressions for ranking #}
{% set seg_check_sum = all_seg_checks | join(' + ') if all_seg_checks else '0' %}
{% set seg_streak_parts = [] %}
{% for i in range(all_seg_checks|length) %}
    {%- set inner = [] %}
    {%- for j in range(i+1) %}{% set _ = inner.append(all_seg_checks[j]) %}{% endfor %}
    {%- set _ = seg_streak_parts.append(' * '.join(inner)) %}
{% endfor %}
{% set seg_streak_expr = ' + '.join(seg_streak_parts) if seg_streak_parts else '0' %}

-- Rows are already unique per UID in the volatile base table; keep a simple
-- pass-through CTE for compatibility with downstream references.
-- Rows in the volatile base table are unique on the global UID set, which
-- may be *wider* than the grouping columns used for this waterfall.  Ensure
-- uniqueness on the *current* uid_cols by applying a ROW_NUMBER partition.

deduped AS (
    SELECT *
    FROM (
        SELECT
            {{ cols_unq | join(', ') }},
            ROW_NUMBER() OVER (PARTITION BY {{ uid_cols | join(', ') }} ORDER BY 1) AS _rn
        FROM base_population AS bp
    ) tmp
    WHERE _rn = 1
),

-- ---------------------------------------------------------------------------
-- Build per-segment candidate & claimed CTEs
-- ---------------------------------------------------------------------------

{% for seg in segments %}
{% set idx = loop.index0 %}

seg_pool_{{ idx }} AS (
    SELECT *
    FROM deduped AS d                          -- ▼ added AS
    {# Exclude anything claimed by earlier segments #}
    {% if idx > 0 %}
    WHERE {% for prev in segments[:idx] %}
              NOT ( {{ prev.summary_column | replace('c.', '') }} )
              {% if not loop.last %}AND{% endif %}
          {% endfor %}
    {% endif %}
),

seg_claim_{{ idx }} AS (
    SELECT *
    FROM seg_pool_{{ idx }} AS sp              -- ▼ added AS
    WHERE {{ seg.summary_column | replace('c.', '') }}
){% if not loop.last %},
{% endif %}

{% endfor %}

-- ---------------------------------------------------------------------------
-- Final SELECT block – emit claimed size + 5-metric waterfall per segment
-- ---------------------------------------------------------------------------

{% for seg in segments %}
{% set idx = loop.index0 %}
{% set check_cols = seg.checks %}

-- >>> Segment: {{ seg.name }} ------------------------------------------------
-- Row 0 – records claimed by the segment
SELECT CAST('{{ seg.name }}' AS VARCHAR(50))    AS section,
       CAST('Records Claimed' AS VARCHAR(50))   AS stat_name,
       CAST('' AS VARCHAR(50))                  AS check_name,
       COUNT(*)                                 AS cntr
FROM seg_claim_{{ idx }}

UNION ALL

-- Metrics evaluated on the *candidate* pool (seg_pool)
SELECT section,
       stat_name,
       check_name,
       cntr
FROM (
    {% for metric in ['unique_drops','incremental_drops','regain'] %}
    {% for col in check_cols %}
    {% set col_idx = loop.index0 %}
    SELECT '{{ seg.name }}'                             AS section,
           '{{ metric }}'                              AS stat_name,
           '{{ col }}'                                 AS check_name,
           SUM(
               CASE
                   {% if metric == 'unique_drops' %}
                       WHEN {{ col }} = 0 THEN 1
                   {% elif metric == 'incremental_drops' %}
                       WHEN {{ col }} = 0
                            {%- for prev in check_cols[:col_idx] %} AND {{ prev }} = 1{% endfor %}
                       THEN 1
                   {% elif metric == 'cumulative_drops' %}
                       WHEN {% for prev in check_cols[:col_idx+1] %} {{ prev }} = 0 {% if not loop.last %}OR{% endif %}{% endfor %}
                       THEN 1
                   {% elif metric == 'regain' %}
                       WHEN {{ col }} = 0
                            {%- for other in check_cols if other != col %} AND {{ other }} = 1{% endfor %}
                       THEN 1
                   {% elif metric == 'remaining' %}
                       WHEN {% for prev in check_cols[:col_idx+1] %} {{ prev }} = 1 {% if not loop.last %}AND{% endif %}{% endfor %}
                       THEN 1
                   {% endif %}
                   ELSE 0
               END
           ) AS cntr
    FROM (
        SELECT {% for uid in uid_cols %}{{ uid }}{{ "," if not loop.last }}{% endfor %}
               {%- if check_cols %}, {% endif %}
               {% for chk in check_cols %}{{ chk }}{{ "," if not loop.last }}{% endfor %}
        FROM seg_pool_{{ idx }}
    ) AS flags({{ (uid_cols + check_cols)|join(', ') }})
    {% if not (metric == 'regain' and col_idx == check_cols|length -1) %}
    UNION ALL
    {% endif %}
    {% endfor %}
    {% endfor %}
) AS metrics

{% if not loop.last %}UNION ALL{% endif %}

{% endfor %}
;
